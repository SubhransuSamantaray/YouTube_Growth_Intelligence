# ==============================================================================
# YouTube Channel Growth Analysis and Intelligence Platform - Environment Variables
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-in-production-to-a-secure-random-string-at-least-32-chars

# Database Configuration
# Default local SQLite database:
DATABASE_URL=sqlite:///./youtube_growth.db
# PostgreSQL alternative for production scale:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/youtube_growth

# YouTube Data API v3 & YouTube Analytics API v2 Credentials
# (Required for live YouTube account sync; mock mode is used when unset)
YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_API_KEY=your-youtube-data-api-v3-api-key
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# YouTube Developer Policy & Compliance Settings
# YouTube Developer Terms Section III.E.4: Raw cached data cannot exceed 30 days
YOUTUBE_DATA_TTL_DAYS=30
STRICT_COMPLIANCE_MODE=True
ENABLE_AUTOMATED_TTL_SWEEP=True
SWEEP_CRON_INTERVAL_HOURS=24

# API Quota Management & Backoff
YOUTUBE_DAILY_QUOTA_LIMIT=10000
QUOTA_ALERT_THRESHOLD=0.85

# Server Ports
API_PORT=8000
STREAMLIT_PORT=8501

# Report Generation Storage
REPORTS_DIR=./reports_generated
EXPORT_DATA_DIR=./data/exports
